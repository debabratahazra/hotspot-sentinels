# Build context is backend/ — see README and .github/skills/cloudrun-deploy.
FROM python:3.11-slim AS builder

# Pinned, not :latest, so dependency resolution is reproducible.
COPY --from=ghcr.io/astral-sh/uv:0.12.3 /uv /bin/uv

WORKDIR /app
# Generated by `uv export --locked --no-dev` — never hand-maintained.
COPY requirements.txt .
RUN uv venv /opt/venv \
    && uv pip install --python /opt/venv/bin/python --no-cache -r requirements.txt


FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    PORT=8080

RUN useradd --create-home --uid 10001 sentinel

WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY main.py verify_setup.py ./
COPY services ./services
COPY tools ./tools

USER sentinel
EXPOSE 8080
# Shell form so Cloud Run's injected PORT is honoured.
CMD ["sh", "-c", "exec uvicorn main:app --host 0.0.0.0 --port ${PORT:-8080}"]
