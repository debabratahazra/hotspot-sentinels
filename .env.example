# Copy this file to .env, then fill in the blanks.
# Running ./setup_gcp.sh generates a real .env for you automatically.
# Never commit .env — .gitignore excludes it and only this template is tracked.
#
# Authentication is Application Default Credentials (`gcloud auth application-default login`).
# There is deliberately no key-file path variable here. Never add one.

# Written by ./setup_gcp.sh from the selected gcloud project.
GOOGLE_CLOUD_PROJECT=

# Mandated by COPILOT_GUIDE.md §2. Do not change.
GOOGLE_CLOUD_REGION=asia-southeast1

# Derived by ./setup_gcp.sh as ${GOOGLE_CLOUD_PROJECT}-data.
GCS_BUCKET_NAME=

# Pub/Sub topic the alert dispatcher publishes CRITICAL zones to.
PUBSUB_TOPIC_ID=heat-resilience-alerts

# Gemini model used by the vision analyzer. Mandated by COPILOT_GUIDE.md §2.
MODEL_ID=gemini-2.5-flash

# Comma-separated origins allowed by the FastAPI CORS middleware.
ALLOWED_ORIGINS=http://localhost:8501

# Port uvicorn binds locally and the port Cloud Run expects.
PORT=8080

GOOGLE_MAPS_API_KEY=