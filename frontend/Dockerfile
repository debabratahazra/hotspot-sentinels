# Build context is frontend/ — see README and .github/skills/cloudrun-deploy.
FROM python:3.11-slim AS builder

# Pinned, not :latest, so dependency resolution is reproducible.
COPY --from=ghcr.io/astral-sh/uv:0.12.3 /uv /bin/uv

WORKDIR /app
# Generated by `uv export --locked --no-hashes --only-group frontend` — never hand-maintained.
COPY requirements.txt .
RUN uv venv /opt/venv \
    && uv pip install --python /opt/venv/bin/python --no-cache -r requirements.txt


FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    PORT=8080

RUN useradd --create-home --uid 10001 sentinel

WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY app.py ./

USER sentinel
EXPOSE 8080
# Streamlit is not a WSGI app: a buildpack-detected gunicorn entrypoint cannot boot it.
# Shell form so Cloud Run's injected PORT is honoured.
CMD ["sh", "-c", "exec streamlit run app.py --server.port=${PORT:-8080} --server.address=0.0.0.0 --server.headless=true --browser.gatherUsageStats=false"]
