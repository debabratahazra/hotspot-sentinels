# Secrets — never commit
.env
.env.*
!.env.example
*-key.json
*_key.json
credentials.json
service-account*.json
*.pem
*.p12
*.pfx

# Python
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Test and coverage artefacts
.coverage
coverage.json
htmlcov/
.pytest-report.xml

# Generated assets
data_samples/

# OS
.DS_Store

# Local tooling symlink into .venv (dangles on a fresh clone)
.agents/

# PowerPoint/Word lock files
~$*

# Alert-wall snapshots taken before a destructive scripts/alert_wall.sh run.
# Local safety net for demo recordings, not project history.
.alert-backups/

# Keynote's own copy of the deck. Opening the .pptx on macOS can leave one
# behind, and twice it replaced the .pptx the submission actually needs.
# The deck is submitted as .pptx in the prescribed template format.
*.key

# Editor config; keep local workspace settings out of a public repo
.vscode/

# Generated at deploy time; public by design but kept out of git so the
# no-keys-in-repo rule stays absolute and gitleaks needs no exception.
public/firebase-config.js

# Firebase CLI deploy cache
.firebase/
